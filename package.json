{
  "name": "soliton",
  "version": "0.0.0",
  "private": true,
  "description": "Soliton — real-time queue and capacity-management platform for neighbourhood salons (monorepo).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "postinstall": "node scripts/fix-styled-jsx-react.cjs"
  },
  "pnpm": {},
  "devDependencies": {
    "@soliton/config": "workspace:*",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
