# ---------------------------------------------------------------------------
# Soliton customer-mobile — environment example (NO SECRETS, NO API KEYS)
# ---------------------------------------------------------------------------

# PUBLIC (safe to bundle) — must be EXPO_PUBLIC_ prefixed to reach app code.
# Points at your own local API. No paid service is used.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Android emulator: use 10.0.2.2 instead of localhost (emulator routes to host machine).
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
# Physical device on same LAN: use your machine's local IP address.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000
# Production:
# EXPO_PUBLIC_API_BASE_URL=https://api.soliton.app
