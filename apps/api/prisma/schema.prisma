// Soliton database schema (Phase 0D). Locked ERD — do not redesign here.
// UUID strategy: DB-side gen_random_uuid() (approved). PostGIS geography + GIST index
// + reviews rating CHECK are manually managed in the migration (see prisma/README.md).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------- enums ----------------
enum Role {
  customer
  staff
  owner
  admin
}

enum SalonRole {
  owner
  staff
}

enum SalonStatus {
  pending
  active
  suspended
}

enum QueueStatus {
  open
  paused
  closed
}

enum EntrySource {
  walkin
  remote
  appointment
}

enum EntryState {
  waiting
  notified
  checked_in
  in_service
  completed
  no_show
  cancelled
  bumped
}

enum Locale {
  en
  hi
}

enum AppointmentStatus {
  scheduled
  confirmed
  checked_in
  in_service
  completed
  cancelled
  no_show
}

enum PaymentStatus {
  none
  pending
  paid
  refunded
}

enum ComplaintStatus {
  open
  in_review
  resolved
  dismissed
}

enum ReviewStatus {
  published
  hidden
  under_review
  removed
}

enum ComplaintCategory {
  service
  wait_time
  booking
  staff_behaviour
  payment
  other
}

// ---------------- core ----------------
model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone           String?  @unique
  email           String?  @unique
  passwordHash    String?
  name            String?
  role            Role     @default(customer)
  locale          Locale   @default(en)
  travelBufferMin Int      @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ownedSalons   Salon[]        @relation("SalonOwner")
  staffRoles    SalonStaff[]
  entries       QueueEntry[]   @relation("EntryCustomer")
  reviews       Review[]
  notifications Notification[]
  deviceTokens  DeviceToken[]
  complaints    Complaint[]    @relation("ComplaintReporter")
  refreshTokens RefreshToken[]
  auditActions  QueueAudit[]   @relation("AuditActor")
  appointments  Appointment[]
  payments      Payment[]

  @@map("users")
}

model Salon {
  id           String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String                                 @db.Uuid
  owner        User                                   @relation("SalonOwner", fields: [ownerId], references: [id])
  name          String
  status        SalonStatus                            @default(pending)
  address       String?
  city          String?
  queueStatus   QueueStatus                            @default(closed)
  averageRating Float?
  reviewCount   Int                                    @default(0)
  bufferConfig Json?
  photoUrl     String?
  createdAt    DateTime                               @default(now())
  updatedAt    DateTime                               @updatedAt

  services     Service[]
  chairs       Chair[]
  staff        SalonStaff[]
  hours        OperatingHours[]
  queue        Queue?
  entries      QueueEntry[]
  reviews      Review[]
  appointments Appointment[]
  complaints   Complaint[]
  payments     Payment[]
  audits       QueueAudit[]

  @@index([ownerId])
  @@index([status])
  @@map("salons")
}

model SalonStaff {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId   String    @db.Uuid
  salon     Salon     @relation(fields: [salonId], references: [id])
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  role      SalonRole @default(staff)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  capabilities  StaffService[]
  servedEntries QueueEntry[]   @relation("EntryStaff")
  appointments  Appointment[]  @relation("StaffAppointments")

  @@unique([salonId, userId])
  @@unique([id, salonId])
  @@index([salonId])
  @@index([userId])
  @@map("salon_staff")
}

model Service {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId          String   @db.Uuid
  salon            Salon    @relation(fields: [salonId], references: [id])
  name             String
  priceCents       Int      @default(0)
  estimatedMinutes Int
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  capableStaff StaffService[]
  entries      QueueEntry[]
  appointments Appointment[]

  @@unique([id, salonId])
  @@index([salonId])
  @@map("services")
}

model StaffService {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonStaffId String @db.Uuid
  serviceId    String @db.Uuid
  salonId      String @db.Uuid

  salonStaff SalonStaff @relation(fields: [salonStaffId, salonId], references: [id, salonId])
  service    Service    @relation(fields: [serviceId, salonId], references: [id, salonId])

  @@unique([salonStaffId, serviceId])
  @@index([serviceId])
  @@index([salonId])
  @@map("staff_services")
}

model Chair {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId   String   @db.Uuid
  salon     Salon    @relation(fields: [salonId], references: [id])
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries QueueEntry[]

  @@index([salonId])
  @@map("chairs")
}

model Queue {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId      String      @unique @db.Uuid
  salon        Salon       @relation(fields: [salonId], references: [id])
  status       QueueStatus @default(closed)
  queueVersion BigInt      @default(0)
  tokenSeq     Int         @default(0)
  sequenceSeq  BigInt      @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  entries QueueEntry[]

  @@map("queues")
}

model QueueEntry {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queueId        String         @db.Uuid
  queue          Queue          @relation(fields: [queueId], references: [id])
  salonId        String         @db.Uuid
  salon          Salon          @relation(fields: [salonId], references: [id])
  customerId     String?        @db.Uuid
  customer       User?          @relation("EntryCustomer", fields: [customerId], references: [id])
  serviceId      String         @db.Uuid
  service        Service        @relation(fields: [serviceId], references: [id])
  source         EntrySource
  tokenNumber    Int
  sequenceNo     BigInt
  state          EntryState     @default(waiting)
  chairId        String?        @db.Uuid
  chair          Chair?         @relation(fields: [chairId], references: [id])
  staffId        String?        @db.Uuid
  staff          SalonStaff?    @relation("EntryStaff", fields: [staffId], references: [id])
  scheduledAt    DateTime?
  graceExpiresAt DateTime?
  estStartAt     DateTime?
  etaMinutes     Int?
  delayMinutes   Int            @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  paymentStatus  PaymentStatus? @default(none)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  review      Review?
  complaints  Complaint[]
  payments    Payment[]
  appointment Appointment? @relation("AppointmentEntry")

  @@index([salonId, state])
  @@index([queueId, sequenceNo])
  @@index([customerId, createdAt])
  @@map("queue_entries")
}

model Appointment {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId           String            @db.Uuid
  salon             Salon             @relation(fields: [salonId], references: [id])
  customerId        String            @db.Uuid
  customer          User              @relation(fields: [customerId], references: [id])
  serviceId         String            @db.Uuid
  service           Service           @relation(fields: [serviceId], references: [id])
  staffId           String?           @db.Uuid
  staff             SalonStaff?       @relation("StaffAppointments", fields: [staffId], references: [id])
  scheduledAt       DateTime
  durationMinutes   Int?
  status            AppointmentStatus @default(scheduled)
  notes             String?
  idempotencyKey    String?           @unique
  arrivalNotifiedAt DateTime?
  graceExpiresAt    DateTime?
  linkedEntryId     String?           @unique @db.Uuid
  linkedEntry       QueueEntry?       @relation("AppointmentEntry", fields: [linkedEntryId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  review     Review?     @relation("AppointmentReview")
  complaints Complaint[] @relation("AppointmentComplaints")
  payments   Payment[]   @relation("AppointmentPayments")

  @@index([salonId, scheduledAt])
  @@index([customerId, scheduledAt])
  @@index([status])
  @@index([salonId, status, scheduledAt])
  @@map("appointments")
}

model Review {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId       String       @db.Uuid
  salon         Salon        @relation(fields: [salonId], references: [id])
  customerId    String       @db.Uuid
  customer      User         @relation(fields: [customerId], references: [id])
  entryId       String?      @unique @db.Uuid
  entry         QueueEntry?  @relation(fields: [entryId], references: [id])
  appointmentId String?      @unique @db.Uuid
  appointment   Appointment? @relation("AppointmentReview", fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
  tags          Json?
  status        ReviewStatus @default(published)
  adminNote     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  complaints Complaint[] @relation("ReviewComplaints")

  @@index([salonId])
  @@index([customerId])
  @@index([status])
  @@map("reviews")
}

model OperatingHours {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId   String @db.Uuid
  salon     Salon  @relation(fields: [salonId], references: [id])
  weekday   Int
  openTime  String
  closeTime String

  @@unique([salonId, weekday])
  @@index([salonId])
  @@map("operating_hours")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  platform  String
  token     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([token])
  @@index([userId])
  @@map("device_tokens")
}

model Complaint {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId    String            @db.Uuid
  reporter      User              @relation("ComplaintReporter", fields: [reporterId], references: [id])
  salonId       String?           @db.Uuid
  salon         Salon?            @relation(fields: [salonId], references: [id])
  entryId       String?           @db.Uuid
  entry         QueueEntry?       @relation(fields: [entryId], references: [id])
  appointmentId String?           @db.Uuid
  appointment   Appointment?      @relation("AppointmentComplaints", fields: [appointmentId], references: [id])
  reviewId      String?           @db.Uuid
  review        Review?           @relation("ReviewComplaints", fields: [reviewId], references: [id])
  category      ComplaintCategory @default(other)
  status        ComplaintStatus   @default(open)
  body          String
  adminNote     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([entryId])
  @@index([status])
  @@index([reporterId])
  @@map("complaints")
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId       String?       @db.Uuid
  entry         QueueEntry?   @relation(fields: [entryId], references: [id])
  appointmentId String?       @db.Uuid
  appointment   Appointment?  @relation("AppointmentPayments", fields: [appointmentId], references: [id])
  customerId    String        @db.Uuid
  customer      User          @relation(fields: [customerId], references: [id])
  salonId       String?       @db.Uuid
  salon         Salon?        @relation(fields: [salonId], references: [id])
  amountCents   Int
  currency      String        @default("INR")
  status        PaymentStatus @default(none)
  provider      String        @default("mock")
  providerRef   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([entryId])
  @@index([customerId])
  @@index([salonId])
  @@index([status])
  @@map("payments")
}

model QueueAudit {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salonId String   @db.Uuid
  salon   Salon    @relation(fields: [salonId], references: [id])
  entryId String?  @db.Uuid
  actorId String?  @db.Uuid
  actor   User?    @relation("AuditActor", fields: [actorId], references: [id])
  action  String
  before  Json?
  after   Json?
  at      DateTime @default(now())

  @@index([salonId, at])
  @@map("queue_audit")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}
