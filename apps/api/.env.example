# ---------------------------------------------------------------------------
# Soliton API — environment example. NO API KEYS. NO PAID SERVICES.
# Copy to .env for local development (.env is gitignored).
# ---------------------------------------------------------------------------

# === FREE LOCAL DEFAULTS (everything Soliton needs to run) ===================
FREE_LOCAL_MODE=true          # only "true" is accepted: there is no paid mode
MAP_PROVIDER=local            # no network, no key; straight-line distance via PostGIS
OTP_PROVIDER=dev              # logs the code outside production; never sends an SMS
PAYMENT_PROVIDER=disabled     # payments are off
MESSAGING_PROVIDER=disabled   # no SMS / WhatsApp / email
STORAGE_PROVIDER=local        # no object storage service
ANALYTICS_PROVIDER=local      # structured local logs only

NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
# Comma-separated allowlist, or "*" to reflect the request origin (dev convenience).
CORS_ORIGINS=*
LOG_LEVEL=info

# Local Docker services (infra/docker-compose.yml): PostgreSQL+PostGIS and Redis.
DATABASE_URL=postgresql://soliton:soliton@localhost:5432/soliton?schema=public
REDIS_URL=redis://localhost:6379

# Optional. A SELF-HOSTED raster tile server for the map background. Leave unset to draw
# markers on a blank canvas (no tile requests at all). Do not point this at a public
# OpenStreetMap tile server for real traffic — their usage policy forbids it.
# MAP_TILE_URL_TEMPLATE=https://tiles.example.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=

# === AI ASSISTANT (optional) =================================================
# The Solitan assistant answers from a local knowledge base by default: no key, no
# network, no account, and it works in the offline demo. Leave this unset and the
# assistant still works.
#
# Google Gemini is an optional enhancement. Both variables are required to enable it,
# so a stray key cannot switch it on by itself.
#
# Before enabling, note what was verified in November 2026: Google does publish a free
# tier that does not require a billing account, but it does NOT publish per-model
# free-tier quotas in its public docs, and third-party summaries disagree with each
# other. No quota figures are encoded in this codebase. Check the rate-limit page for
# your own project in AI Studio. Quota exhaustion (HTTP 429) is handled as a normal
# outcome: the assistant falls back to the local guide and says so.
#
# Never commit a real key. This file is an example; the real one is .env (gitignored).
# ASSISTANT_PROVIDER=gemini
# GEMINI_API_KEY=
# Flash models have stayed free-tier eligible; Pro models reportedly left the free tier
# in April 2026. Override if that changes again.
# GEMINI_MODEL=gemini-2.5-flash

# === AUTH ====================================================================
# Required only in production. Generate your own long random value; never commit it.
# JWT_ACCESS_SECRET=

# === PILOT MODE ==============================================================
# Set true during the initial Raipur pilot to enable operational warnings and explicit
# mock-provider labels. Customers never see pilot internals.
PILOT_MODE=false

# === OPTIONAL FUTURE PROVIDERS ===============================================
# None. Paid providers (SMS, payments, hosted maps, email, analytics, AI) are NOT part of
# Soliton and are not configurable. Adding one needs an explicit decision and new code.
