{
  "name": "@soliton/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tooling (ESLint/Prettier) and typed environment/config foundation for Soliton.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint": "./eslint.mjs",
    "./prettier": "./prettier.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"@soliton/config: no tests\""
  },
  "dependencies": {
    "@eslint/js": "^9.15.0",
    "globals": "^15.12.0",
    "typescript-eslint": "^8.15.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "eslint": "^9",
    "prettier": "^3"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
