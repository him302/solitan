{
  "name": "@soliton/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed HTTP client for the Soliton API (shared by mobile and admin).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
