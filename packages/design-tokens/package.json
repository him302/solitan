{
  "name": "@soliton/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Platform-neutral design tokens (RN theme + web CSS variables) for Soliton.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/css.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "dev": "echo \"@soliton/design-tokens: no dev task\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
