# React Native / Expo, Next.js and NestJS resolve dependencies more reliably with a
# hoisted node_modules layout in a monorepo. Metro in particular does not follow
# pnpm's default symlinked store well.
node-linker=hoisted

# The React Native ecosystem ships many loose/duplicated peer ranges; do not fail
# installs on peer mismatches (they are surfaced as warnings instead).
strict-peer-dependencies=false
